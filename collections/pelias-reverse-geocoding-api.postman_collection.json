  "item": [
    {
      "id": "7cd866b9-0e8a-45a2-a9d5-07080a8d6583",
      "name": "Reverse Geocoding",
      "description": {
        "content": "Convert geographic coordinates into places and addresses",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "ce2adfe5-1706-42b7-a64c-ade592e07fd9",
          "name": "Reverse geocode coordinates into place/address",
          "request": {
            "name": "Reverse geocode coordinates into place/address",
            "description": {
              "content": "Given a latitude and longitude, returns the nearest places and addresses from all available data sources. Optionally filter by source, layer, or boundary.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "reverse"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "point.lat",
                  "value": "<float>",
                  "description": "(Required) Latitude of the point to reverse geocode (decimal degrees)"
                },
                {
                  "disabled": false,
                  "key": "point.lon",
                  "value": "<float>",
                  "description": "(Required) Longitude of the point to reverse geocode (decimal degrees)"
                },
                {
                  "disabled": false,
                  "key": "boundary.circle.radius",
                  "value": "<float>",
                  "description": "Radius in km within which to restrict results (max 5)"
                },
                {
                  "disabled": false,
                  "key": "size",
                  "value": "10",
                  "description": "Maximum number of results to return (default 10, max 40)"
                },
                {
                  "disabled": false,
                  "key": "lang",
                  "value": "<string>",
                  "description": "BCP47 language tag for preferred response language (e.g. en, fr, de). Not all places have translated names.\n"
                },
                {
                  "disabled": false,
                  "key": "boundary.country",
                  "value": "<string>",
                  "description": "Comma-separated list of ISO-3166 alpha-2 or alpha-3 country codes to restrict results\n"
                },
                {
                  "disabled": false,
                  "key": "boundary.gid",
                  "value": "<string>",
                  "description": "Pelias gid of an administrative area to restrict results within"
                },
                {
                  "disabled": false,
                  "key": "sources",
                  "value": "<string>",
                  "description": "Comma-separated list of data sources to query. Valid values: openstreetmap (osm), openaddresses (oa), whosonfirst (wof), geonames (gn)\n"
                },
                {
                  "disabled": false,
                  "key": "layers",
                  "value": "<string>",
                  "description": "Comma-separated list of layer types to restrict results. Valid values: venue, address, street, neighbourhood, borough, localadmin, locality, county, macrocounty, region, macroregion, country, coarse, postalcode\n"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
