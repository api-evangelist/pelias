      "name": "Forward Geocoding",
      "description": {
        "content": "Convert text or addresses into geographic coordinates",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "2c32d433-acf1-4fb8-945c-7b520ecc19db",
          "name": "Forward geocode a free-form text query",
          "request": {
            "name": "Forward geocode a free-form text query",
            "description": {
              "content": "Search for places by free-form text. Returns up to 10 GeoJSON features by default. Supports filtering by data source, layer, bounding box, circle, and country.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "text",
                  "value": "<string>",
                  "description": "(Required) Free-form text to geocode (addresses, place names, etc.)"
                },
                {
                  "disabled": false,
                  "key": "size",
                  "value": "10",
                  "description": "Maximum number of results to return (default 10, max 40)"
                },
                {
                  "disabled": false,
                  "key": "lang",
                  "value": "<string>",
                  "description": "BCP47 language tag for preferred response language (e.g. en, fr, de). Not all places have translated names.\n"
                },
                {
                  "disabled": false,
                  "key": "focus.point.lat",
                  "value": "<float>",
                  "description": "Latitude of the focus point to boost nearby results"
                },
                {
                  "disabled": false,
                  "key": "focus.point.lon",
                  "value": "<float>",
                  "description": "Longitude of the focus point to boost nearby results"
                },
                {
                  "disabled": false,
                  "key": "boundary.rect.min_lon",
                  "value": "<float>",
                  "description": "Minimum longitude of rectangular boundary (western edge)"
                },
                {
                  "disabled": false,
                  "key": "boundary.rect.max_lon",
                  "value": "<float>",
                  "description": "Maximum longitude of rectangular boundary (eastern edge)"
                },
                {
                  "disabled": false,
                  "key": "boundary.rect.min_lat",
                  "value": "<float>",
                  "description": "Minimum latitude of rectangular boundary (southern edge)"
                },
                {
                  "disabled": false,
                  "key": "boundary.rect.max_lat",
                  "value": "<float>",
                  "description": "Maximum latitude of rectangular boundary (northern edge)"
                },
                {
                  "disabled": false,
                  "key": "boundary.circle.lat",
                  "value": "<float>",
                  "description": "Latitude of the center of a circular boundary"
                },
                {
                  "disabled": false,
                  "key": "boundary.circle.lon",
                  "value": "<float>",
                  "description": "Longitude of the center of a circular boundary"
                },
                {
                  "disabled": false,
                  "key": "boundary.circle.radius",
                  "value": "<float>",
                  "description": "Radius in km of the circular boundary"
                },
                {
                  "disabled": false,
                  "key": "boundary.country",
                  "value": "<string>",
                  "description": "Comma-separated list of ISO-3166 alpha-2 or alpha-3 country codes to restrict results\n"
                },
                {
                  "disabled": false,
                  "key": "boundary.gid",
                  "value": "<string>",
                  "description": "Pelias gid of an administrative area to restrict results within"
                },
                {
                  "disabled": false,
                  "key": "sources",
                  "value": "<string>",
                  "description": "Comma-separated list of data sources to query. Valid values: openstreetmap (osm), openaddresses (oa), whosonfirst (wof), geonames (gn)\n"
                },
                {
                  "disabled": false,
                  "key": "layers",
                  "value": "<string>",
                  "description": "Comma-separated list of layer types to restrict results. Valid values: venue, address, street, neighbourhood, borough, localadmin, locality, county, macrocounty, region, macroregion, country, coarse, postalcode\n"
                }
              ],
              "variable": []
            },
